{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_response.filePath // .tool_input.file_path'); case \"$f\" in *.blade.php) ;; *.php) \"$CLAUDE_PROJECT_DIR/vendor/bin/pint\" \"$f\" >/dev/null 2>&1 || true ;; esac",
            "timeout": 30,
            "statusMessage": "Running Pint..."
          }
        ]
      }
    ]
  }
}
